ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database
ODOO_USERNAME=your_username
ODOO_PASSWORD=your_password
# Optional: use ODOO_API_KEY instead of ODOO_PASSWORD

# Sales MCP (python -m sales_mcp) — second Railway service, same env as above.
# Use a dedicated Odoo user with CRM + Contacts + Activities only if possible.
# Optional overrides for activity type display names in Odoo:
# ODOO_CALL_ACTIVITY_TYPE_NAME=Call
# ODOO_MEETING_ACTIVITY_TYPE_NAME=Meeting
# Default date timezone when occurred_on is omitted (log_note):
# ODOO_SALES_DATE_TZ=Europe/Helsinki

# Slack bot (optional — only needed when running slack_bot.py)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_ALLOWED_CHANNEL=team-x-files
